{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "timezone": "Asia/Dhaka",
  "schedule": [
    "after 11:00pm on sunday",
    "before 5:00am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pub"
      ],
      "groupName": "flutter-pub-dependencies",
      "labels": [
        "dependencies",
        "flutter"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions-dependencies",
      "labels": [
        "dependencies",
        "ci"
      ]
    }
  ]
}
